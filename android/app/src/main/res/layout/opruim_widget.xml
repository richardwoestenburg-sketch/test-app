<?xml version="1.0" encoding="utf-8"?>
<!-- De knop op het startscherm: icoon, naam en wat de vorige ronde opleverde. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/opruim_widget_knop"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="8dp"
    android:background="@drawable/opruim_widget_achtergrond"
    android:contentDescription="@string/opruim_widget_naam">

    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_opruim"
        android:contentDescription="@null" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/opruim_widget_naam"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/opruim_widget_onder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/opruim_widget_hint"
        android:textColor="#E0F7FC"
        android:textSize="10sp" />
</LinearLayout>
